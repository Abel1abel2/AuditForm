@inherits LayoutComponentBase
  <AuthorizeView>
            <Authorized>
            <div class="page">
                <div class="sidebar ">
                    <NavMenu />
                </div>

                <main>
                    <div class="top-row px-4 d-flex justify-content-center align-items-center auth-header" >

             <div class="text-muted fw-semibold bg-white border px-4 py-2 rounded-pill shadow-sm d-none d-md-block">
                        <i class="bi bi-calendar3 text-primary me-2"></i>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </div>
                    </div>

                    <article class="content px-4">
                        @Body
                    </article>
                </main>
            </div>
 </Authorized>
            <NotAuthorized>                
                <article class="content px-4">
                        @Body
                </article>
            </NotAuthorized>
        </AuthorizeView>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
