@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar ">

    <div class="container-fluid">
        <a class="navbar-brand" href="">AuditForm</a>
    </div>

</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">       
     

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-4">
                    <hr class="text-muted opacity-25" />
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu text-primary" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>
                @if (context.User.IsInRole("Admin"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/users">
                            <span class="bi bi-people-fill-nav-menu text-warning" aria-hidden="true"></span> Manage Users
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Register">
                            <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                        </NavLink>
                    </div>
                }                   
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="">
                        <span class="bi bi-person-fill-nav-menu text-primary" aria-hidden="true"></span> @context.User.Identity?.Name
                        <!-- NEW: Show the user's role as a badge -->
                        <span class="badge bg-secondary ms-2" style="font-size: 0.65rem;">
                            @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl"/>
                       <button type="submit" class="nav-link w-100 text-start custom-logout-btn">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<style>
    /* Resets default button styling and guarantees it matches standard Blazor sidebar options */
    .custom-logout-btn {
        background: none !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0.6rem 1rem !important;
        display: flex;
        align-items: center;
        width: 100%;
        text-decoration: none;
    }

        /* Maintains consistent hover behaviors across your menu items */
        .custom-logout-btn:hover {
            background-color: rgba(255, 255, 255, 0.1) !important;
            color: white !important;
        }
</style>