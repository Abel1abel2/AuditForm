@page "/Account/Register"
@using System.ComponentModel.DataAnnotations
@using AuditForm.Data
@using AuditForm.Dtos
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Identity
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@using AuditForm.Repositary
@inject LDPServices Ldp

<PageTitle>Register</PageTitle>
<Card>
    <CardHeader>
        <h1>Register</h1>
        <Button Type="ButtonType.Button" @onclick="HandleAddNew">
            <Icon Name="IconName.PlusCircle"/> Add New User
        </Button>
    </CardHeader>
    <CardBody>
        @if (flagAddNew && domainUser is null)
        {
            <div class="row">
                 <div class="col-md-4">
                        <InputText @bind-Value="searName" class="form-control" 
                        placeholder="Enter user full name to search" />
                 </div>            
                 <div class="col-md-2">
                      <button type="button" @onclick="SearchOnLDP" class="w-100 btn btn-lg btn-info">Search</button>
                 </div>   
            </div>
                @if(domainUsers !=null && domainUsers.Any() && domainUser is null)
                {
                    <ul>
                    @foreach(var d in domainUsers)
                    {
                        <li @onclick="@(()=>HanldeSelect(d))">@d.DisplayName</li>
                    }
                    </ul>
                }
        }else if(flagAddNew && domainUser is not null)
        {
            <div class="row">
                <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
                    <DataAnnotationsValidator />
                    <h2>Create a new account.</h2>
                    <hr />
                    <ValidationSummary class="text-danger" role="alert" />
                     <div class="alert alert-info">
                        @domainUser.DisplayName
                    </div>
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="Input.Username" id="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="username" />
                        <label for="Input.Username">Username</label>
                        <ValidationMessage For="() => Input.Username" class="text-danger" />
                    </div>            
            
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                </EditForm>
            </div>
        }
    </CardBody>
    <CardFooter>
        @if (Users is not null && Users.Any())
        {
            <QuickGrid TGridItem="ApplicationUser"
                       Items="@Users.AsQueryable()"
                       Class="table table-hover table-striped table-sm align-middle">

                <PropertyColumn Property="u => u.Id"
                                Title="ID"
                                Sortable="true" />

                <PropertyColumn Property="u => u.UserName"
                                Title="Username"
                                Sortable="true" />
              

            </QuickGrid>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No users found.
            </div>
        }

    </CardFooter>
</Card>




@code {
    private IEnumerable<IdentityError>? identityErrors;
    bool flagAddNew;

    [SupplyParameterFromForm]
    private UserRegDto Input  { get; set; } = default!;
    private List<ApplicationUser> Users { get; set; } = new();
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
    private List<DomainUser> domainUsers { get; set; }
    private DomainUser domainUser { get; set; }
    private string searName { get; set; }
    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        Input ??= new();
        LoadUsers();
    }
    void LoadUsers()
    {
        Users =  UserManager.Users.ToList();
    }
    public async Task RegisterUser(EditContext editContext)
    {
        var user = CreateUser();

        await UserStore.SetUserNameAsync(user, Input.Username, CancellationToken.None);

        var result = await UserManager.CreateAsync(user);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with username.");

        // --- ADD THIS BLOCK TO ASSIGN DEFAULT ROLE ---
        await UserManager.AddToRoleAsync(user, "Audit");

        LoadUsers();
        // ---------------------------------------------        
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'.");
        }
    }


    private void HandleAddNew()
    {
        Input = new UserRegDto();
        flagAddNew = true;
    }

    private async Task SearchOnLDP()
    {
        if (string.IsNullOrWhiteSpace(searName))
            return;

        domainUsers = await Ldp.SearchUsersByFullName(searName.Trim());        
    }

    private void HanldeSelect(DomainUser d)
    {
        domainUser = d;
        Input.Username = d.Username;
    }
}