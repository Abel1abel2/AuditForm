@page "/Account/Register"

@attribute [Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using AuditForm.Data
@using AuditForm.Dtos
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IUserStore<ApplicationUser> UserStore
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@using AuditForm.Repositary
@inject LDPServices Ldp

<PageTitle>Register</PageTitle>

<Card>
    <CardHeader>
        <h1>Register</h1>
        <Button Type="ButtonType.Button" @onclick="HandleAddNew">
            <Icon Name="IconName.PlusCircle"/> Add New User
        </Button>
    </CardHeader>
    <CardBody>
        @if (flagAddNew && domainUser is null)
        {
            <!-- Modernized Search Input -->
            <div class="row mb-4">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label fw-semibold text-muted small mb-2">Search Active Directory</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <InputText @bind-Value="searName" class="form-control" placeholder="Enter user full name..." />
                        <button type="button" @onclick="SearchOnLDP" class="btn btn-info text-white fw-semibold px-4">Search</button>
                    </div>
                </div>
            </div>
            
            <!-- Modernized Search Results -->
            @if(domainUsers != null && domainUsers.Any() && domainUser is null)
            {
                <div class="mt-2">
                    <h6 class="fw-bold text-muted mb-3"><i class="bi bi-people-fill me-2"></i>Search Results</h6>
                    <div class="list-group shadow-sm" style="max-width: 600px;">
                        @foreach(var d in domainUsers)
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center py-3" @onclick="@(()=>HanldeSelect(d))">
                                <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="text-start">
                                    <div class="fw-bold text-dark">@d.DisplayName</div>
                                    <small class="text-muted">@d.Username</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-muted"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else if(flagAddNew && domainUser is not null)
        {
            <div class="row">
                <div class="col-md-6 col-lg-5">
                    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
                        <DataAnnotationsValidator />
                        <h4 class="mb-3">Create Account</h4>
                        <ValidationSummary class="text-danger" role="alert" />
                        
                        <div class="alert alert-info d-flex align-items-center shadow-sm">
                            <i class="bi bi-person-check-fill fs-4 me-3"></i>
                            <div>
                                <div class="fw-bold">@domainUser.DisplayName</div>
                                <small>Selected from Directory</small>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="Input.Username" id="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="username" readonly />
                            <label for="Input.Username">Username</label>
                            <ValidationMessage For="() => Input.Username" class="text-danger" />
                        </div>            
                        <div class="form-floating mb-3">
                            <InputSelect @bind-Value="Input.Role" id="Input.Role" class="form-select" aria-required="true">
                                <option value="">Select Role</option>
                                @foreach (var role in Roles)
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </InputSelect>  
                            <label for="Input.Role">Role</label>
                            <ValidationMessage For="() => Input.Role" class="text-danger" />
                        </div>  
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                    </EditForm>
                </div>
            </div>
        }
    </CardBody>
    <CardFooter Class="p-0">
        @if (Users is not null && Users.Any())
        {
            <div class="table-responsive">
                <QuickGrid TGridItem="ApplicationUser"
                           Items="@Users.AsQueryable()"
                           Class="table table-hover table-striped align-middle mb-0">

                    <!-- User Column -->
                    <TemplateColumn Title="Username" Sortable="true" SortBy="GridSort<ApplicationUser>.ByAscending(u => u.UserName)">
                        <div class="d-flex align-items-center py-2 px-3">
                            <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3 shadow-sm" style="width: 35px; height: 35px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <span class="fw-semibold text-dark fs-6">@context.UserName</span>
                        </div>
                    </TemplateColumn>

                    <!-- Redirect to Admin Users page for role change -->
                    <TemplateColumn Title="Role Action">
                        <div class="px-3">
                            <button class="btn btn-sm btn-outline-primary shadow-sm" @onclick='() => NavigationManager.NavigateTo("/admin/users")'>
                                <i class="bi bi-pencil-square"></i> Change
                            </button>
                        </div>
                    </TemplateColumn>

                    <!-- Actions Column -->
                    <TemplateColumn Title="Actions" Align="Align.End">
                        <div class="px-3">
                            <button class="btn btn-sm btn-outline-danger shadow-sm" @onclick="() => ShowDeleteConfirmation(context)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </TemplateColumn>

                </QuickGrid>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0 m-3">
                No users found.
            </div>
        }
    </CardFooter>
</Card>

<!-- CUSTOM DELETE MODAL -->
@if (showDeleteModal)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-card shadow-lg">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">Are you sure?</h4>
            <p class="text-muted mb-4">
                Do you really want to delete user <strong>@userToDelete?.UserName</strong>? This process cannot be undone.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-outline-secondary px-4" @onclick="CancelDelete">No, Cancel</button>
                <button class="btn btn-danger px-4 shadow-sm" @onclick="ConfirmDelete">
                    <i class="bi bi-trash me-1"></i> Yes, Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<IdentityError>? identityErrors;
    bool flagAddNew;

    [SupplyParameterFromForm]
    private UserRegDto Input  { get; set; } = default!;
    private List<ApplicationUser> Users { get; set; } = new();
    private List<IdentityRole> Roles { get; set; } = new();
    private List<DomainUser> domainUsers { get; set; }
    private DomainUser domainUser { get; set; }
    private string searName { get; set; }

    // State for the custom Delete Modal
    private bool showDeleteModal = false;
    private ApplicationUser? userToDelete;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await LoadRolesAsync();
        await LoadUsersAsync();
    }
    async Task LoadRolesAsync()
    {
        Roles = await RoleManager.Roles.ToListAsync();
    }
    async Task LoadUsersAsync()
    {
        Users = await UserManager.Users.ToListAsync();
    }

    // Opens the modal
    private void ShowDeleteConfirmation(ApplicationUser user)
    {
        if (user.UserName == "Abel.Girma") 
        {
            identityErrors = new[] { new IdentityError { Description = "You cannot delete your own admin account." } };
            return;
        }

        userToDelete = user;
        showDeleteModal = true;
    }

    // Closes the modal without doing anything
    private void CancelDelete()
    {
        showDeleteModal = false;
        userToDelete = null;
    }

    // Executes the actual deletion
    private async Task ConfirmDelete()
    {
        if (userToDelete == null) return;

        var result = await UserManager.DeleteAsync(userToDelete);
        if (result.Succeeded)
        {
            await LoadUsersAsync();
            showDeleteModal = false;
            userToDelete = null;
        }
        else
        {
            identityErrors = result.Errors;
            showDeleteModal = false;
        }
    }

    public async Task RegisterUser(EditContext editContext)
    {
        var user = CreateUser();
        await UserStore.SetUserNameAsync(user, Input.Username, CancellationToken.None);

        var result = await UserManager.CreateAsync(user);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }
        
        var roleResult = await UserManager.AddToRoleAsync(user, Input.Role);

        Logger.LogInformation("User created a new account with username.");
       

        flagAddNew = false;
        domainUser = null;
        domainUsers = null;
        searName = string.Empty;
        
        await LoadUsersAsync();
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'.");
        }
    }

    private void HandleAddNew()
    {
        Input = new UserRegDto();
        flagAddNew = true;
        domainUser = null;
        domainUsers = null;
    }

    private async Task SearchOnLDP()
    {
        if (string.IsNullOrWhiteSpace(searName))
            return;

        domainUsers = await Ldp.SearchUsersByFullName(searName.Trim());        
    }

    private void HanldeSelect(DomainUser d)
    {
        domainUser = d;
        Input.Username = d.Username;
    }
}

<!-- CSS for the Custom Modal -->
<style>
    .custom-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5); /* Shadows the background */
        z-index: 1050;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(2px); /* Adds a nice blur effect */
    }

    .custom-modal-card {
        background-color: white;
        padding: 2rem;
        border-radius: 1rem;
        width: 90%;
        max-width: 450px;
        text-align: center;
    }
</style>