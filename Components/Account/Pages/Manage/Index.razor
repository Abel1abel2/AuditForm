@page "/Account/Manage"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using AuditForm.Data
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Manage your account</PageTitle>

<h3>Manage your account</h3>

<AuthorizeView>
    <Authorized>
        <!-- READ-ONLY VIEW FOR AUDIT USERS -->
        <AuthorizeView Roles="Audit" Context="AuditContext">
            <div class="alert alert-info mt-3">
                <h5><i class="bi bi-info-circle"></i> Read-Only Profile</h5>
                <p class="mb-0">Your account is an <strong>Audit</strong> account. You cannot change your profile details. Please contact an Administrator if you need to make changes.</p>
            </div>
            <div class="card mt-3 shadow-sm border-0">
                <div class="card-body">
                    <p><strong>Username:</strong> @AuditContext.User.Identity?.Name</p>
                    <p><strong>Role:</strong> @AuditContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
                </div>
            </div>
        </AuthorizeView>

        <!-- EDITABLE VIEW FOR ADMIN USERS -->
        <AuthorizeView Roles="Admin" Context="AdminContext">
            <div class="alert alert-success mt-3">
                <h5><i class="bi bi-shield-check"></i> Admin Profile</h5>
                <p class="mb-0">You have full access to update your account details below.</p>
            </div>
            
            <!-- PASTE YOUR EXISTING EDIT FORMS HERE -->
            <!-- (The default template has sections for changing email, password, etc.) -->
            <!-- Example: -->
            <div class="card mt-3">
                <div class="card-body">
                    <h4>Change Password</h4>
                    <!-- Your existing Change Password form goes here -->
                </div>
            </div>
            
        </AuthorizeView>
    </Authorized>
</AuthorizeView>