@page "/frauds/create"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using BlazorBootstrap
@inject IDbContextFactory<AuditForm.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Fraud Case</PageTitle>

<div class="container py-4" style="max-width: 960px;">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Create Fraud Case</h1>
            <p class="text-muted mb-0 small">Register a new fraud entry in the general ledger.</p>
        </div>
        <a href="/frauds" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <EditForm method="post" Model="Fraud" OnValidSubmit="AddFraud" FormName="create" Enhance>
        <DataAnnotationsValidator />

        <!-- Global validation summary -->
        <ValidationSummary class="text-danger mb-3" role="alert" />

        <!-- SECTION 1: Classification -->
        <Card Class="border-0 shadow-sm mb-3">
            <CardHeader Class="bg-white border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tags text-primary"></i>
                    <h6 class="fw-semibold mb-0">Classification</h6>
                </div>
            </CardHeader>
            <CardBody>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="category" class="form-label fw-semibold">
                            Category <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="category" @bind-Value="Fraud.Category" class="form-select" aria-required="true">
                            <option value="">-- Select a Category --</option>
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Fraud.Category" class="text-danger small" />
                    </div>

                    <div class="col-md-6">
                        <label for="fraudtype" class="form-label fw-semibold">
                            Fraud Type <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="fraudtype" @bind-Value="Fraud.FraudType" class="form-select" aria-required="true">
                            <option value="">-- Select a Fraud Type --</option>
                            @foreach (var type in FraudTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Fraud.FraudType" class="text-danger small" />
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- SECTION 2: Previous State -->
        <Card Class="border-0 shadow-sm mb-3">
            <CardHeader Class="bg-white border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-secondary"></i>
                    <h6 class="fw-semibold mb-0">Previous State</h6>
                </div>
            </CardHeader>
            <CardBody>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="previousnumber" class="form-label fw-semibold">Previous Count</label>
                        <InputNumber id="previousnumber" @bind-Value="Fraud.PreviousNumber" class="form-control" />
                        <ValidationMessage For="() => Fraud.PreviousNumber" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label for="previousamount" class="form-label fw-semibold">Previous Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <InputNumber id="previousamount" @bind-Value="Fraud.PreviousAmount" class="form-control" />
                        </div>
                        <ValidationMessage For="() => Fraud.PreviousAmount" class="text-danger small" />
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- SECTION 3: Current State -->
        <Card Class="border-0 shadow-sm mb-3">
            <CardHeader Class="bg-white border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-activity text-primary"></i>
                    <h6 class="fw-semibold mb-0">Current State</h6>
                </div>
            </CardHeader>
            <CardBody>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="currentnumber" class="form-label fw-semibold">Current Count</label>
                        <InputNumber id="currentnumber" @bind-Value="Fraud.CurrentNumber" class="form-control" />
                        <ValidationMessage For="() => Fraud.CurrentNumber" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label for="currentamount" class="form-label fw-semibold">Current Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <InputNumber id="currentamount" @bind-Value="Fraud.CurrentAmount" class="form-control" />
                        </div>
                        <ValidationMessage For="() => Fraud.CurrentAmount" class="text-danger small" />
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- SECTION 4: Recovery -->
        <Card Class="border-0 shadow-sm mb-3">
            <CardHeader Class="bg-white border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-counterclockwise text-success"></i>
                    <h6 class="fw-semibold mb-0">Recovery</h6>
                </div>
            </CardHeader>
            <CardBody>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="recoverednumber" class="form-label fw-semibold">Recovered Count</label>
                        <InputNumber id="recoverednumber" @bind-Value="Fraud.RecoveredNumber" class="form-control" />
                        <ValidationMessage For="() => Fraud.RecoveredNumber" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label for="recoveredamount" class="form-label fw-semibold">Recovered Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <InputNumber id="recoveredamount" @bind-Value="Fraud.RecoveredAmount" class="form-control" />
                        </div>
                        <ValidationMessage For="() => Fraud.RecoveredAmount" class="text-danger small" />
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- Computed outstanding preview -->
        <div class="alert alert-danger d-flex align-items-center gap-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle fs-4"></i>
            <div class="flex-grow-1">
                <div class="fw-semibold mb-1">Computed Outstanding</div>
                <div class="small">
                    Outstanding = (Previous + Current) − Recovered.
                    The values below are calculated automatically on save.
                </div>
            </div>
            <div class="text-end">
                <div class="small text-uppercase fw-semibold">Count</div>
                <div class="fs-5 fw-bold">
                    @(Fraud.PreviousNumber + Fraud.CurrentNumber - Fraud.RecoveredNumber)
                </div>
            </div>
            <div class="text-end border-start ps-3">
                <div class="small text-uppercase fw-semibold">Amount</div>
                <div class="fs-5 fw-bold">
                    @((Fraud.PreviousAmount + Fraud.CurrentAmount - Fraud.RecoveredAmount).ToString("N2"))
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2">
            <a href="/frauds" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-check-lg me-2"></i>Create Case
            </button>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private Fraud Fraud { get; set; } = default!;

    private readonly List<string> Categories = new()
    {
        "Cash", "Deposit Account", "Loan", "Forex",
        "Interbank Accounts", "Clearing", "Off-Balance Sheet",
        "Check / DDs", "Others"
    };

    private readonly List<string> FraudTypes = new()
    {
        "Embezzlement", "Cheating", "Forgery / Using Fake Instruments", "Other"
    };

    protected override void OnInitialized() => Fraud ??= new();

    private async Task AddFraud()
    {
        Fraud.OutstandingNumber = Fraud.PreviousNumber + Fraud.CurrentNumber - Fraud.RecoveredNumber;
        Fraud.OutstandingAmount = Fraud.PreviousAmount + Fraud.CurrentAmount - Fraud.RecoveredAmount;

        using var context = DbFactory.CreateDbContext();
        context.Fraud.Add(Fraud);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/frauds");
    }
}