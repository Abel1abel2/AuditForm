@page "/frauds/create"

@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using BlazorBootstrap
@inject IDbContextFactory<AuditForm.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Register Fraud</PageTitle>

<div class="container py-4" style="max-width: 960px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Register Fraud</h1>
            <p class="text-muted mb-0 small">Log a single fraud occurrence.</p>
        </div>
        <a href="/frauds" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <EditForm Model="Fraud" OnValidSubmit="AddFraud">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger mb-3" role="alert" />

        <Card Class="border-0 shadow-sm mb-3">
            <CardHeader Class="bg-white border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    <h6 class="fw-semibold mb-0">Fraud Occurrence</h6>
                </div>
            </CardHeader>
            <CardBody>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="occurredon" class="form-label fw-semibold">
                            Date occurred <span class="text-danger">*</span>
                        </label>
                        <InputDate id="occurredon" @bind-Value="Fraud.OccurredOn" class="form-control" />
                        <ValidationMessage For="() => Fraud.OccurredOn" class="text-danger small" />
                    </div>

                    <div class="col-md-4">
                        <label for="category" class="form-label fw-semibold">
                            Category <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="category" @bind-Value="Fraud.Category" class="form-select">
                            <option value="">-- Select --</option>
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Fraud.Category" class="text-danger small" />
                    </div>

                    <div class="col-md-4">
                        <label for="fraudtype" class="form-label fw-semibold">
                            Fraud type <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="fraudtype" @bind-Value="Fraud.FraudType" class="form-select">
                            <option value="">-- Select --</option>
                            @foreach (var t in FraudTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Fraud.FraudType" class="text-danger small" />
                    </div>

                    <div class="col-md-4">
                        <label for="amount" class="form-label fw-semibold">
                            Amount <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <InputNumber id="amount" @bind-Value="Fraud.Amount" class="form-control" />
                        </div>
                        <ValidationMessage For="() => Fraud.Amount" class="text-danger small" />
                    </div>

                    <div class="col-md-4">
                        <label for="status" class="form-label fw-semibold">Status</label>
                        <InputSelect id="status" @bind-Value="Fraud.Status" class="form-select">
                            <option>Open</option>
                            <option>Under review</option>
                            <option>Recovered</option>
                            <option>Closed</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label for="reportedby" class="form-label fw-semibold">Reported by</label>
                        <InputText id="reportedby" @bind-Value="Fraud.ReportedBy" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <InputTextArea id="description" @bind-Value="Fraud.Description"
                                       class="form-control" rows="4"
                                       placeholder="What happened, who is involved, how it was detected…" />
                    </div>

                </div>
            </CardBody>
        </Card>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/frauds" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 shadow-sm" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bi bi-check-lg me-2"></i>Register fraud
            </button>
        </div>
    </EditForm>
</div>

@code {
    private Fraud Fraud { get; set; } = NewFraud();
    private bool _saving;

    private static Fraud NewFraud() => new()
    {
        OccurredOn = DateTime.Today,
        Status = "Open",
        Category = "",
        FraudType = ""
    };

    private readonly List<string> Categories = new()
    {
        "Cash", "Deposit Account", "Loan","Forex",
        "Interbank Accounts","Clearing","Off-Balance Sheet",
        "Check / DDs", "Others"
    };

    private readonly List<string> FraudTypes = new()
    {
        "Embezzlement", "Cheating", "Forgery / Using Fake Instruments", "Other"
    };

    private async Task AddFraud()
    {
        _saving = true;
        try
        {
            Fraud.CreatedAt = DateTime.UtcNow;

            await using var context = await DbFactory.CreateDbContextAsync();
            context.Fraud.Add(Fraud);
            await context.SaveChangesAsync();

            NavigationManager.NavigateTo("/frauds");
        }
        finally
        {
            _saving = false;
        }
    }
}