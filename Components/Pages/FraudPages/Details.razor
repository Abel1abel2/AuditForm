@page "/frauds/details"

@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using BlazorBootstrap
@inject IDbContextFactory<AuditForm.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Fraud Details</PageTitle>

<div class="container py-4" style="max-width: 960px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Fraud Details</h1>
            <p class="text-muted mb-0 small">Detailed view of a registered fraud entry.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@BackUrl" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
            @if (fraud is not null)
            {
                <a href="@EditUrl" class="btn btn-primary shadow-sm">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
            }
        </div>
    </div>

    @if (fraud is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading details...</span>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <Card Class="border-0 shadow-sm h-100">
                    <CardHeader Class="bg-primary text-white border-0 py-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-tags fs-5"></i>
                            <h5 class="mb-0 fw-semibold">Fraud Info</h5>
                        </div>
                    </CardHeader>
                    <CardBody Class="p-4">
                        <div class="mb-4">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Date Occurred</div>
                            <div class="fs-5 fw-bold text-dark">@fraud.OccurredOn.ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="mb-4">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Category</div>
                            <div class="fs-5 fw-bold text-dark">@(fraud.Category ?? "N/A")</div>
                        </div>
                        <div class="mb-4">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">Fraud Type</div>
                            <div class="fs-5 fw-bold text-dark">@(fraud.FraudType ?? "N/A")</div>
                        </div>
                        <hr class="my-4 text-muted opacity-25" />
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Status</div>
                                <div class="fw-semibold text-dark">@fraud.Status</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Reported By</div>
                                <div class="fw-semibold text-dark">@(fraud.ReportedBy ?? "—")</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(fraud.Description))
                        {
                            <div>
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Description</div>
                                <div class="text-dark">@fraud.Description</div>
                            </div>
                        }
                    </CardBody>
                </Card>
            </div>

            <div class="col-lg-6">
                <Card Class="border-0 shadow-lg mb-4" Style="border-left: 5px solid #5a8dfb !important;">
                    <CardBody Class="p-4 d-flex flex-column justify-content-center h-100">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-cash-stack text-primary fs-4"></i>
                            <h5 class="fw-bold mb-0 text-primary">Amount</h5>
                        </div>
                        <div class="bg-primary-subtle rounded p-4 text-center">
                            <div class="fs-1 fw-bold text-primary">
                                @fraud.Amount.ToString("N2")
                            </div>
                        </div>
                    </CardBody>
                </Card>
            </div>
        </div>
    }
</div>

@code {
    private Fraud? fraud;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromQuery]
    private string? Category { get; set; }

    // Where "Back to List" goes — category page if we came from there
    private string BackUrl =>
        string.IsNullOrEmpty(Category)
            ? "/frauds"
            : $"/frauds/category/{Uri.EscapeDataString(Category)}";

    // "Edit" link keeps the category in the URL so Edit can return there too
    private string EditUrl =>
        string.IsNullOrEmpty(Category)
            ? $"/frauds/edit?id={Id}"
            : $"/frauds/edit?id={Id}&category={Uri.EscapeDataString(Category)}";

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        fraud = await context.Fraud.FirstOrDefaultAsync(m => m.Id == Id);
        if (fraud is null) NavigationManager.NotFound();
    }
}