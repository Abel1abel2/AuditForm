@page "/frauds/delete"

@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using BlazorBootstrap
@inject IDbContextFactory<AuditForm.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Fraud</PageTitle>

<div class="container py-4" style="max-width: 800px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Delete Fraud</h1>
            <p class="text-muted mb-0 small">Review the record before confirming deletion.</p>
        </div>
        <a href="@BackUrl" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    @if (fraud is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading details...</span>
        </div>
    }
    else
    {
        <div class="alert alert-danger d-flex align-items-center gap-3 shadow-sm border-danger-subtle mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Are you sure?</h5>
                <p class="mb-0 small">This action cannot be undone. This will permanently delete the fraud record.</p>
            </div>
        </div>

        <Card Class="border-0 shadow-sm mb-4">
            <CardHeader Class="bg-light border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0 text-secondary">Fraud Summary</h6>
                </div>
            </CardHeader>
            <CardBody Class="p-4">
                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Date Occurred</div>
                        <div class="fs-6 fw-bold text-dark">@fraud.OccurredOn.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Status</div>
                        <div class="fs-6 fw-bold text-dark">@fraud.Status</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Category</div>
                        <div class="fs-6 fw-bold text-dark">@(fraud.Category ?? "N/A")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Fraud Type</div>
                        <div class="fs-6 fw-bold text-dark">@(fraud.FraudType ?? "N/A")</div>
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4" />

                <div class="bg-primary-subtle rounded p-3 text-center">
                    <div class="text-primary-emphasis small fw-semibold mb-1">Amount</div>
                    <div class="fs-3 fw-bold text-primary-emphasis">$@fraud.Amount.ToString("N2")</div>
                </div>
            </CardBody>
        </Card>

        <div class="d-flex justify-content-end gap-2">
            <a href="@BackUrl" class="btn btn-outline-secondary px-4">Cancel</a>
            <button class="btn btn-danger px-4 shadow-sm" @onclick="DeleteFraud">
                <i class="bi bi-trash me-2"></i>Confirm Delete
            </button>
        </div>
    }
</div>

@code {
    private Fraud? fraud;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromQuery]
    private string? Category { get; set; }

    // Where "Back", "Cancel", and the post-delete redirect should go
    private string BackUrl =>
        string.IsNullOrEmpty(Category)
            ? "/frauds"
            : $"/frauds/category/{Uri.EscapeDataString(Category)}";

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        fraud = await context.Fraud.FirstOrDefaultAsync(m => m.Id == Id);
        if (fraud is null) NavigationManager.NotFound();
    }

    private async Task DeleteFraud()
    {
        if (fraud is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Fraud.Remove(fraud);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo(BackUrl);
    }
}