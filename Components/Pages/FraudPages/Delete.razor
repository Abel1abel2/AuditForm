@page "/frauds/delete"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using BlazorBootstrap
@inject IDbContextFactory<AuditForm.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Fraud Case</PageTitle>

<div class="container py-4" style="max-width: 800px;">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Delete Fraud Case</h1>
            <p class="text-muted mb-0 small">Review the record before confirming deletion.</p>
        </div>
        <a href="/frauds" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    @if (fraud is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading case details...</span>
        </div>
    }
    else
    {
        <!-- Warning Alert -->
        <div class="alert alert-danger d-flex align-items-center gap-3 shadow-sm border-danger-subtle mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Are you sure?</h5>
                <p class="mb-0 small">This action cannot be undone. This will permanently delete the fraud case record from the database.</p>
            </div>
        </div>

        <!-- Case Summary Card -->
        <Card Class="border-0 shadow-sm mb-4">
            <CardHeader Class="bg-light border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0 text-secondary">Case Summary</h6>
                </div>
            </CardHeader>
            <CardBody Class="p-4">
                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Category</div>
                        <div class="fs-6 fw-bold text-dark">@(fraud.Category ?? "N/A")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Fraud Type</div>
                        <div class="fs-6 fw-bold text-dark">@(fraud.FraudType ?? "N/A")</div>
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4" />

                <div class="row g-3">
                    <!-- Financial summary blocks -->
                    <div class="col-md-4">
                        <div class="bg-light rounded p-3 text-center">
                            <div class="text-muted small fw-semibold mb-1">Previous Amt</div>
                            <div class="fw-semibold">@fraud.PreviousAmount.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-primary-subtle rounded p-3 text-center">
                            <div class="text-primary-emphasis small fw-semibold mb-1">Current Amt</div>
                            <div class="fw-semibold text-primary-emphasis">@fraud.CurrentAmount.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-success-subtle rounded p-3 text-center">
                            <div class="text-success-emphasis small fw-semibold mb-1">Recovered</div>
                            <div class="fw-semibold text-success-emphasis">@fraud.RecoveredAmount.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="bg-danger-subtle rounded p-3 d-flex justify-content-between align-items-center border border-danger-subtle">
                        <div class="text-danger-emphasis fw-bold">Total Outstanding Amount</div>
                        <div class="fs-4 fw-bold text-danger">@fraud.OutstandingAmount.ToString("N2")</div>
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- Action Buttons -->
        <EditForm method="post" Model="fraud" OnValidSubmit="DeleteFraud" FormName="delete" Enhance>
            <div class="d-flex justify-content-end gap-2">
                <a href="/frauds" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 shadow-sm" disabled="@(fraud is null)">
                    <i class="bi bi-trash me-2"></i>Confirm Delete
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private Fraud? fraud;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        fraud = await context.Fraud.FirstOrDefaultAsync(m => m.Id == Id);

        if (fraud is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteFraud()
    {
        using var context = DbFactory.CreateDbContext();
        context.Fraud.Remove(fraud!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/frauds");
    }
}