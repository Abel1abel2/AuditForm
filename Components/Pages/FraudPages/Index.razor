@page "/frauds"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using AuditForm.Data
@using BlazorBootstrap
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Fraud Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Fraud Dashboard</h1>
            <p class="text-muted mb-0 small">
                Total entries: <span class="fw-semibold text-dark">@(fraudList?.Count ?? 0)</span>
            </p>
        </div>
        <a href="frauds/create" class="btn btn-primary px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Register Fraud
        </a>
    </div>

    <!-- Summary Cards -->
    @if (fraudList != null && fraudList.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <Card Style="border: none; border-left: 3px solid #5a8dfb; border-bottom: 10px solid #5a8dfb;" Class="shadow-lg h-100">
                    <CardBody>
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Total Amount</div>
                        <div class="fs-3 fw-bold text-dark">
                            <i class="bi text-primary bi-cash-stack fs-4"></i>
                            $@fraudList.Sum(f => f.Amount).ToString("N2")
                        </div>
                    </CardBody>
                </Card>
            </div>
            <div class="col-md-6">
                <Card Style="border: none; border-left: 3px solid #fe9d50; border-bottom: 10px solid #fe9d50;" Class="shadow-lg h-100">
                    <CardBody>
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Active Cases</div>
                        <div class="fs-3 fw-bold text-dark">
                            <i class="bi text-warning bi-exclamation-triangle fs-4"></i>
                            @fraudList.Count(f => f.Status != "Closed" && f.Status != "Recovered")
                        </div>
                    </CardBody>
                </Card>
            </div>
        </div>
    }

    <hr />

    <!-- Filter Section -->
    <Card Class="border-0 shadow-sm mb-4">
        <CardBody Class="p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-8 col-sm-12">
                    <label class="form-label small fw-semibold text-muted mb-1">Filter by category</label>
                    <select @bind="FilterCategory" class="form-select">
                        <option value="">All categories</option>
                        @foreach (var cat in allCategories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-sm-12 d-flex gap-2">
                    <button @onclick="LoadFraudsAsync" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Find
                    </button>
                    <button @onclick="ClearFilter" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                </div>
            </div>
        </CardBody>
    </Card>

    <!-- Category Dashboard Tiles -->
    @if (fraudList == null)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-4">
            <div class="spinner-border spinner-border-sm"></div><span>Loading fraud records...</span>
        </div>
    }
    else if (!fraudList.Any())
    {
        <Card Class="border-0 shadow-sm">
            <CardBody Class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h5 class="fw-semibold mt-3 mb-1">No fraud records found</h5>
            </CardBody>
        </Card>
    }
    else
    {
        <h3 class="mb-3">Categories</h3>
        <div class="row g-3">
            @foreach (var g in CategoryGroups())
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="category-tile card border-0 shadow-sm h-100" @onclick="() => OpenCategory(g.Key)">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">
                                    @g.Key
                                </span>
                                <span class="badge bg-dark-subtle text-dark">@g.Count()</span>
                            </div>
                            <div class="small-label mt-3">Total amount</div>
                            <div class="fs-4 fw-bold text-dark mb-2">
                                $@g.Sum(f => f.Amount).ToString("N2")
                            </div>
                            <div class="text-end mt-2 small text-primary fw-semibold">
                                View Cases <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private ApplicationDbContext context = default!;
    private List<Fraud>? fraudList;
    private List<string> allCategories = new();
    private string? FilterCategory { get; set; }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        await LoadCategoriesAsync();
        await LoadFraudsAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        var cats = await context.Fraud
            .Select(f => f.Category)
            .Distinct()
            .ToListAsync();

        allCategories = cats
            .Select(c => string.IsNullOrWhiteSpace(c) ? "Others" : c)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
    }

    private async Task LoadFraudsAsync()
    {
        var q = context.Fraud.AsQueryable();

        if (!string.IsNullOrEmpty(FilterCategory))
        {
            if (FilterCategory == "Others")
                q = q.Where(f => string.IsNullOrWhiteSpace(f.Category));
            else
                q = q.Where(f => f.Category == FilterCategory);
        }

        // Changed to CreatedAt so newest records are fetched first
        fraudList = await q.OrderByDescending(f => f.CreatedAt).ToListAsync();
    }

    private async Task ClearFilter()
    {
        FilterCategory = null;
        await LoadFraudsAsync();
    }

    // Group by the Category field, then order the GROUPS by the newest record inside them
    private IEnumerable<IGrouping<string, Fraud>> CategoryGroups() =>
        fraudList!
            .GroupBy(f => string.IsNullOrWhiteSpace(f.Category) ? "Others" : f.Category)
            .OrderByDescending(g => g.Max(f => f.CreatedAt)); // Order tiles by newest creation date

    private void OpenCategory(string category) =>
        NavigationManager.NavigateTo($"/frauds/category/{Uri.EscapeDataString(category)}");

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}

<style>
    .category-tile {
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .category-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.08) !important;
        }

    .small-label {
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6b7280;
        margin-bottom: .15rem;
    }
</style>