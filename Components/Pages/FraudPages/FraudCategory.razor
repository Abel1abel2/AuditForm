@page "/frauds/category/{CategoryName}"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using AuditForm.Data
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>@CategoryName – Fraud Records</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </button>
        <h1 class="fw-bold mb-0 ms-2">@CategoryName Records</h1>
    </div>

    <!-- Date Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-8 col-sm-12">
                    <label class="form-label small fw-semibold text-muted mb-1">Find by exact date</label>
                    <input type="date" @bind="FilterDate" class="form-control" />
                </div>
                <div class="col-md-4 col-sm-12 d-flex gap-2">
                    <button @onclick="LoadFraudsAsync" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Find
                    </button>
                    <button @onclick="ClearFilter" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (fraudList == null)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading records...</span>
        </div>
    }
    else if (!fraudList.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-info-circle me-2"></i>No records found for @CategoryName@(FilterDate.HasValue ? $" on {FilterDate.Value:yyyy-MM-dd}" : "").
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date Occurred</th>
                            <th>Fraud Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fraud in fraudList)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar-event me-1"></i>@fraud.OccurredOn.ToString("yyyy-MM-dd")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        @(fraud.FraudType ?? "Unclassified")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    $@fraud.Amount.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @{
                                        var badgeClass = fraud.Status switch
                                        {
                                            "Closed" => "bg-success-subtle text-success",
                                            "Recovered" => "bg-info-subtle text-info",
                                            "Open" => "bg-warning-subtle text-warning",
                                            _ => "bg-secondary-subtle text-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">
                                        @fraud.Status
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@($"frauds/details?id={fraud.Id}&category={Uri.EscapeDataString(CategoryName)}")" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="@($"frauds/edit?id={fraud.Id}&category={Uri.EscapeDataString(CategoryName)}")" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="@($"frauds/delete?id={fraud.Id}&category={Uri.EscapeDataString(CategoryName)}")" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string CategoryName { get; set; } = string.Empty;

    private ApplicationDbContext context = default!;
    private List<Fraud>? fraudList;
    private DateTime? FilterDate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        await LoadFraudsAsync();
    }

    private async Task LoadFraudsAsync()
    {
        var q = context.Fraud.AsQueryable();

        // Always filter by the category from the route
        if (CategoryName == "Others")
            q = q.Where(f => string.IsNullOrEmpty(f.Category));
        else
            q = q.Where(f => f.Category == CategoryName);

        // Apply date filter if set
        if (FilterDate.HasValue)
            q = q.Where(f => f.OccurredOn.Date == FilterDate.Value.Date);

        fraudList = await q
            .OrderByDescending(f => f.CreatedAt)
            .ToListAsync();
    }

    private async Task ClearFilter()
    {
        FilterDate = null;
        await LoadFraudsAsync();
    }

    private void GoBack() => NavigationManager.NavigateTo("/frauds");

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}