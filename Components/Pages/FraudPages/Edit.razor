@page "/frauds/edit"

@using Microsoft.EntityFrameworkCore
@using AuditForm.Model
@using BlazorBootstrap
@inject IDbContextFactory<AuditForm.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit Fraud</PageTitle>

<div class="container py-4" style="max-width: 960px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Edit Fraud</h1>
            <p class="text-muted mb-0 small">Update the details of this fraud entry.</p>
        </div>
        <a href="@BackUrl" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    @if (Fraud is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted p-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading details...</span>
        </div>
    }
    else
    {
        <EditForm Model="Fraud" OnValidSubmit="UpdateFraud">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" role="alert" />

            <Card Class="border-0 shadow-sm mb-3">
                <CardHeader Class="bg-white border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle text-danger"></i>
                        <h6 class="fw-semibold mb-0">Fraud Occurrence</h6>
                    </div>
                </CardHeader>
                <CardBody>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Date Occurred <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="Fraud.OccurredOn" class="form-control" />
                            <ValidationMessage For="() => Fraud.OccurredOn" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="Fraud.Category" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var cat in Categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Fraud.Category" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fraud Type <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="Fraud.FraudType" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var t in FraudTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Fraud.FraudType" class="text-danger small" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="Fraud.Amount" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status</label>
                            <InputSelect @bind-Value="Fraud.Status" class="form-select">
                                <option>Open</option>
                                <option>Under review</option>
                                <option>Recovered</option>
                                <option>Closed</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Reported By</label>
                            <InputText @bind-Value="Fraud.ReportedBy" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <InputTextArea @bind-Value="Fraud.Description" class="form-control" rows="4" />
                        </div>
                    </div>
                </CardBody>
            </Card>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="@BackUrl" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-check-lg me-2"></i>Save Changes
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromQuery]
    private string? Category { get; set; }

    private Fraud? Fraud;

    private readonly List<string> Categories = new()
    {
        "Cash", "Deposit Account", "Loan", "Forex",
        "Interbank Accounts", "Clearing", "Off-Balance Sheet",
        "Check / DDs", "Others"
    };

    private readonly List<string> FraudTypes = new()
    {
        "Embezzlement", "Cheating", "Forgery / Using Fake Instruments", "Other"
    };

    // Where "Back to List", "Cancel", and the post-save redirect go
    private string BackUrl =>
        string.IsNullOrEmpty(Category)
            ? "/frauds"
            : $"/frauds/category/{Uri.EscapeDataString(Category)}";

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        Fraud = await context.Fraud.FirstOrDefaultAsync(f => f.Id == Id);
        if (Fraud is null) NavigationManager.NotFound();
    }

    private async Task UpdateFraud()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Fraud.Update(Fraud!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo(BackUrl);
    }
}